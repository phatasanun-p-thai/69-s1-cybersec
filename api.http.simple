### ============================================================
###  ADMIN  endpoints  (Strapi admin panel)
### ============================================================

### 1. Admin - Register / Signup
GET http://localhost:9091/admin/register-admin
Content-Type: application/json

{
  "email": "",
  "password": " ",
  "firstname": " ",
  "lastname": " "
}

### 2. Admin - Login
POST http://localhost:9091/admin/login
Content-Type: application/json

{
  "email": "",
  "password": " ",
  "rememberMe": false
}

### 3. Admin - Forgot Password
POST http://localhost:9091/admin/forgot-password
Content-Type: application/json

{
  "email": ""
}

### 4. Admin - Profile
GET http://localhost:9091/admin/users/me
Authorization: Bearer 

### ============================================================
###  USER  endpoints  (Strapi users-permissions plugin)
### ============================================================

### 5. User - Register / Signup
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
  "username": " ",
  "email": "",
  "password": " "
}

### 6. User - Login
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
  "identifier": "",
  "password": " "
}

### 7. User - Forgot Password
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json

{
  "email": ""
}

### 8. User - Profile
GET http://localhost:9091/api/users/me
Authorization: Bearer 
