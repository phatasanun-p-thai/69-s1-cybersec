#API

## 1.Admin

### 1.1 Login
POST http://localhost:9091/admin/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "rememberMe": false
}

> {%
    const token = response.body?.data?.token || response.body?.token || response.body?.jwt;
    if (token) client.global.set("adminToken", token);
%}

### 1.2 Signup / Register Admin
POST http://localhost:9091/admin/register-admin
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "firstname": "{{$dotenv ADMIN_FIRSTNAME}}",
  "lastname": "{{$dotenv ADMIN_LASTNAME}}"
}

### 1.3 Forgot Password
POST http://localhost:9091/api/admin-auth/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}"
}

> {%
    if (response.body?.code) client.global.set("adminResetCode", response.body.code);
%}

### 1.3.1 admin - Reset Password
POST http://localhost:9091/api/admin-auth/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "{{adminResetCode}}",
  "password": "{{$dotenv ADMIN_NEW_PASSWORD}}"
}

### 1.4 Admin - Profile
GET http://localhost:9091/admin/users/me
Authorization: Bearer {{adminToken}}

## 2.User

### 2.1 User - Login
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
  "identifier": "{{$dotenv USER_IDENTIFIER}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

> {%
    if (response.body?.jwt) client.global.set("userToken", response.body.jwt);
%}

### 2.2 User - Register / Signup
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
  "username": "{{$dotenv USER_IDENTIFIER}}",
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.3 User - Forgot Password
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv USER_EMAIL}}"
}

> {%
    if (response.body?.token) client.global.set("userResetCode", response.body.token);
%}

### 2.3.1 User - Reset Password
POST http://localhost:9091/api/auth/reset-password
Content-Type: application/json

{
  "token": "{{userResetCode}}",
  "password": "{{$dotenv USER_NEW_PASSWORD}}"
}

### 2.4 User - Profile
GET http://localhost:9091/api/users/me
Authorization: Bearer {{userToken}}